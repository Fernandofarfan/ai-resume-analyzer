{
    "name": "ai-resume-analyzer",
    "version": "1.0.0",
    "description": "Smart ATS Resume Analyzer & Optimizer with local privacy and multi-provider AI",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20",
        "npm": ">=10"
    },
    "scripts": {
        "build": "node scripts/sync-pdf-worker.mjs && react-router build",
        "check:server": "node --check server/index.mjs && node --check server/config.mjs && node --check server/ai.mjs && node --check server/lib.mjs",
        "check:docker-config": "node scripts/docker-smoke-check.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check . && node scripts/format-check.mjs",
        "dev": "node scripts/sync-pdf-worker.mjs && react-router dev",
        "lint": "eslint . && npm run format:check && npm run check:server && npm run check:docker-config && npm run typecheck",
        "lint:fix": "eslint . --fix && prettier --write .",
        "start": "node server/index.mjs",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "typecheck": "react-router typegen && tsc"
    },
    "dependencies": {
        "@react-router/node": "^7.18.4",
        "clsx": "^2.1.1",
        "isbot": "^5",
        "pdfjs-dist": "^6.3.289",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-dropzone": "^14.3.8",
        "react-router": "^7.18.4",
        "tailwind-merge": "^3.3.1",
        "zustand": "^5.0.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@react-router/dev": "^8.4.0",
        "@tailwindcss/vite": "^4.1.4",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.2",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitest/coverage-v8": "^5.0.2",
        "eslint": "^10.11.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-react-hooks": "^7.1.1",
        "fake-indexeddb": "^6.2.5",
        "globals": "^17.12.0",
        "jsdom": "^30.1.1",
        "prettier": "^3.9.9",
        "tailwindcss": "^4.1.4",
        "tw-animate-css": "^1.3.5",
        "typescript": "^7.0.2",
        "typescript-eslint": "^8.70.1",
        "vite": "^8.3.0",
        "vite-tsconfig-paths": "^6.1.1",
        "vitest": "^5.0.2"
    }
}
