# ==============================================================================
# CVision AI — Configuración de Variables de Entorno
# ==============================================================================
#
# NOTA IMPORTANTE DE SEGURIDAD:
# Las claves de API y las credenciales de los proveedores de IA son SECRETAS y
# SOLO se leen desde el servidor (server/index.mjs). Nunca se exponen al
# navegador. No uses el prefijo `VITE_` para ninguna credencial.
#
# Para usar proveedores remotos debes arrancar la app con el servidor incluido:
#   npm run build && npm start
# En desarrollo (`npm run dev`) no hay servidor de API, por lo que se utiliza el
# motor heurístico local.
# ==============================================================================

# Proveedor de Inteligencia Artificial (leído por el servidor)
#   - "offline" : Motor heurístico local (100% privado, sin internet/API keys).
#   - "gemini"  : Google Gemini API.
#   - "groq"    : Groq Cloud API.
#   - "ollama"  : Servidor Ollama local en tu máquina.
AI_PROVIDER=offline

# Clave de API de Google Gemini (requerida si AI_PROVIDER=gemini)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Modelo de Gemini (opcional, por defecto gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Clave de API de Groq (requerida si AI_PROVIDER=groq)
# Obtén tu clave en: https://console.groq.com/keys
GROQ_API_KEY=

# Modelo de Groq (opcional, por defecto llama-3.1-8b-instant)
GROQ_MODEL=llama-3.1-8b-instant

# Configuración de Ollama Local (requerida si AI_PROVIDER=ollama)
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3

# --- Endurecimiento del servidor (opcional) ---

# Entorno de ejecución: development | production.
NODE_ENV=production

# Puerto HTTP del servidor.
PORT=3000

# Token opcional de autenticación para la API (Bearer token o cabecera x-api-key).
# Si se define, todas las llamadas a /api/analyze requieren este token.
# NOTA: En producción (NODE_ENV=production), si se utiliza un proveedor remoto
# (gemini, groq, u ollama remoto) es OBLIGATORIO definir API_AUTH_TOKEN (mínimo 16 caracteres),
# o bien habilitar explícitamente ALLOW_PUBLIC_AI=true.
API_AUTH_TOKEN=

# ⚠️ ADVERTENCIA DE SEGURIDAD:
# Si se establece ALLOW_PUBLIC_AI=true, el endpoint /api/analyze queda expuesto
# públicamente en internet sin requerir autenticación previa.
# Úsalo únicamente en demos públicas o servidores con protección a nivel de red (WAF / Cloudflare Access).
ALLOW_PUBLIC_AI=false

# Si la app está detrás de proxies inversos confiables (Cloudflare, Nginx, ALB, Traefik),
# especifica la lista explícita de IPs o subredes de proxies de confianza:
# TRUSTED_PROXY_IPS=10.0.0.50,198.51.100.99
#
# O bien define TRUST_PROXY=true únicamente en redes privadas / loopback de confianza:
TRUST_PROXY=false

# Máximo de análisis de IA simultáneos en el servidor.
MAX_CONCURRENT=4

# Presupuesto global diario de análisis (protección contra abuso/costos).
MAX_DAILY_ANALYSES=500

# Reintentos de llamada al proveedor ante errores transitorios (429/5xx).
MAX_RETRIES=2

# Máximo de tokens de salida por análisis.
MAX_OUTPUT_TOKENS=2048

# Máximo de caracteres aceptados en la respuesta del proveedor.
MAX_RESPONSE_CHARS=50000

# Presupuesto total de tiempo (ms) para un análisis, incluyendo reintentos.
MAX_PROVIDER_DURATION_MS=55000

# Envía la cabecera Strict-Transport-Security (HSTS).
# RECOMENDACIÓN: Actívalo (ENABLE_HSTS=true) en entornos de producción con HTTPS.
ENABLE_HSTS=false

# NOTA: El endpoint /api/analyze exige consentimiento explícito (flag `consent`)
# antes de reenviar datos a un proveedor remoto. Para una app pública, protege el
# endpoint con autenticación real mediante un reverse proxy (p. ej. Auth0,
# session cookie HttpOnly, Cloudflare Access) en lugar de tokens estáticos.
