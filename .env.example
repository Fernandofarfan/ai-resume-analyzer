# ==============================================================================
# CVision AI — Configuración de Variables de Entorno
# ==============================================================================

# Proveedor de Inteligencia Artificial
# Opciones disponibles:
#   - "offline" : Motor heurístico local (100% privado, rápido y sin internet/API keys).
#   - "gemini"  : Google Gemini API (modelo gemini-1.5-flash).
#   - "groq"    : Groq Cloud API (modelo llama-3.1-8b-instant).
#   - "ollama"  : Servidor Ollama local en tu máquina.
VITE_AI_PROVIDER=offline

# Clave de API de Google Gemini (requerida si VITE_AI_PROVIDER=gemini)
# Obtén tu clave en: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# Clave de API de Groq (requerida si VITE_AI_PROVIDER=groq)
# Obtén tu clave en: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Configuración de Ollama Local (requerida si VITE_AI_PROVIDER=ollama)
VITE_OLLAMA_ENDPOINT=http://localhost:11434
VITE_OLLAMA_MODEL=llama3
